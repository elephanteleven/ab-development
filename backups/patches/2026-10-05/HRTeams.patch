+      // A new request is valid through this UTC day ("YYYY-MM-DD").
+      _principalChangeNewExpiryDay() {
+         const day = new Date();
+         day.setUTCDate(day.getUTCDate() + PRINCIPAL_CHANGE_EXPIRY_DAYS);
+         return day.toISOString().slice(0, 10);
+      }
+
+      // The last UTC day a request is valid. Rows from before expires_on
+      // existed count from created_at.
+      _principalChangeExpiryDay(value) {
+         const day = this._principalChangeDay(value.expires_on);
+         if (day != null) return day;
+         const created = new Date(value.created_at);
+         if (isNaN(created)) return null;
+         created.setUTCDate(
+            created.getUTCDate() + PRINCIPAL_CHANGE_EXPIRY_DAYS
+         );
+         return created.toISOString().slice(0, 10);
+      }
+
+      _isPrincipalChangeExpired(value) {
+         const day = this._principalChangeExpiryDay(value);
+         return day != null && day < new Date().toISOString().slice(0, 10);
+      }
+
+      // The calendar day a date field holds. The browser model gives local
+      // midnight (2026-10-09T17:00:00.000Z for 2026-10-10 at UTC+7), the
+      // server UTC midnight, so read each the way it was written.
+      _principalChangeDay(date) {
+         if (date == null || date === "") return null;
+         if (
+            typeof date === "string" &&
+            /^\d{4}-\d{2}-\d{2}($|T00:00:00(\.0+)?Z$)/.test(date)
