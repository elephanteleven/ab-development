+      // The other entity's HR has to approve this principal change. Nothing
+      // is saved to NetSuite here: one cache-principal-change row gets a copy
+      // of everything the approval needs, and the process
+      // "Principal Change Approval" (NetSuite HR Update) starts on it.
+      async _requestPrincipalChange(customProcessTasks) {
+         const webix = this.AB.Webix;
+         const escape = webix.template.escape;
+         try {
+            const principalChangeDC = DcContainer.list.principalChange;
+            // The plugin and the NetSuite HR Update definitions ship together.
+            if (principalChangeDC == null)
+               throw new Error(
+                  this.label(
+                     "The object cache-principal-change is missing in this tenant."
+                  )
+               );
+            // Read from the chart's own data collection, so no request goes
+            // to the server here. A request someone else sent after the chart
+            // loaded is not in it; the process checks NetSuite again before
+            // it writes anything, so such a duplicate changes nothing.
+            const pendingValues = principalChangeDC.getData(
+               (value) =>
+                  value.employee_email ===
+                     customProcessTasks.employeeValueEmail &&
+                  value.status === PRINCIPAL_CHANGE_STATUS_PENDING
+            );
+            const pendingValue = pendingValues.find(
+               (value) => !this._isPrincipalChangeExpired(value)
+            );
+            if (pendingValue) {
+               await webix.alert({
+                  title: this.label("Already waiting for approval"),
+                  ok: this.label("OK"),
+                  text: this.label(
+                     "{0} asked on {1} to make this person principal. That request is still waiting for the other entity's HR, so a new one cannot be sent yet. It expires after {2} (UTC); then a new one can be sent.",
+                     [
+                        escape(pendingValue.requested_by),
+                        escape(
+                           new Date(
+                              pendingValue.created_at
+                           ).toLocaleDateString()
+                        ),
+                        escape(
+                           this._principalChangeDayText(
+                              this._principalChangeExpiryDay(pendingValue)
+                           )
+                        ),
+                     ]
+                  ),
+               });
+               return;
+            }
+            // Only expired requests are left. They block nothing, and the
+            // process ignores a late answer to them, so remove them.
